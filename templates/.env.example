# ─────────────────────────────────────────────────────────────────────────────
# Ideamart configuration
#
#   cp .env.example .env
#
# `.env` MUST be git-ignored. This file is committed and must only ever contain
# placeholders — never a real applicationId or password.
#
# In production do not ship a `.env` at all: use your host's secret manager.
#
# NEVER prefix any of these with NEXT_PUBLIC_ / VITE_ / REACT_APP_ — those are
# compiled into the browser bundle and become world-readable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials ─────────────────────────────────────────────────────────────
# The only two values every Ideamart application needs. Both come from IdeaPro
# provisioning. Treat the password like a payment key: it can send SMS to your
# whole subscriber base and debit money from your subscribers' mobile accounts.

IDEAMART_APP_ID=APP_XXXXXX
IDEAMART_PASSWORD=replace-me


# ── Service endpoints ───────────────────────────────────────────────────────
# Uncomment ONLY the endpoints for the APIs enabled on your application in
# IdeaPro. An application can only call services it was provisioned for —
# calling anything else fails with E1309 no matter how correct the payload is.
#
# Leaving an endpoint unset is how your code knows the service is unavailable:
# the client should refuse to call it rather than fail at the platform.

# ── SMS ──
#IDEAMART_SMS_SEND_URL=https://api.ideamart.io/sms/send

# ── USSD ──
#IDEAMART_USSD_SEND_URL=https://api.ideamart.io/ussd/send

# ── Subscription ──
# One endpoint serves both register (action 1) and unregister (action 0).
#IDEAMART_SUBSCRIPTION_SEND_URL=https://api.ideamart.io/subscription/send
#IDEAMART_SUBSCRIPTION_STATUS_URL=https://api.ideamart.io/subscription/getStatus
#IDEAMART_SUBSCRIPTION_QUERY_BASE_URL=https://api.ideamart.io/subscription/query-base

# ── OTP ── (registering web/app users from a plain mobile number)
#IDEAMART_OTP_REQUEST_URL=https://api.ideamart.io/subscription/otp/request
#IDEAMART_OTP_VERIFY_URL=https://api.ideamart.io/subscription/otp/verify

# ── CaaS ── charging
#IDEAMART_CAAS_DEBIT_URL=https://api.ideamart.io/caas/direct/debit
# Balance query also needs "Enable Query Balance Requests" in CaaS provisioning.
#IDEAMART_CAAS_BALANCE_URL=https://api.ideamart.io/caas/balance/query

# ── LBS ── note the different host
#IDEAMART_LBS_URL=https://api.dialog.lk/lbs/locate


# ─────────────────────────────────────────────────────────────────────────────
# OmniAI — the Ideamart AI gateway
#
# A SEPARATE product with a SEPARATE key. The credentials above will not
# authenticate an OmniAI call, and the key below will not authenticate an SMS
# send. Get the key from https://omniai.ideamart.io.
#
# It travels in an Authorization header — verbatim, no "Bearer" prefix — not in
# the JSON body like every telco API above. See references/14-omni-ai.md.
#
# This key spends a real prepaid token balance and is NOT IP-whitelisted, so a
# leak works from anywhere until you rotate it. Treat it exactly like the
# password above: backend only, never in a client bundle.
# ─────────────────────────────────────────────────────────────────────────────

#OMNIAI_API_KEY=replace-me

# Uncomment only the endpoints you use.
#OMNIAI_CHAT_COMPLETIONS_URL=https://api.ideamart.io/omniai/api/v1/chat/completions
#OMNIAI_IMAGE_GENERATIONS_URL=https://api.ideamart.io/omniai/api/v1/images/generations
