# ─────────────────────────────────────────────────────────────────────────────
# Ideamart configuration
#
# Copy to `.env` and fill in the real values.
#   cp .env.example .env
#
# `.env` MUST be git-ignored. This file (`.env.example`) is committed and must
# only ever contain placeholders — never a real applicationId or password.
#
# In production, do not ship a `.env` file at all: use your host's secret
# manager (Vercel/Netlify env vars, AWS Secrets Manager, GCP Secret Manager,
# Azure Key Vault, Kubernetes Secrets, Docker secrets).
#
# NEVER prefix any of these with NEXT_PUBLIC_ / VITE_ / REACT_APP_ — those are
# compiled into the browser bundle and become world-readable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Credentials (from IdeaPro provisioning) ─────────────────────────────────
# Format: APP_ followed by six digits.
IDEAMART_APP_ID=APP_XXXXXX

# The password issued when your application was provisioned.
# Treat this like a payment key: it can send SMS to your entire subscriber base
# and debit money from your subscribers' mobile accounts.
IDEAMART_PASSWORD=replace-me

# ── Endpoints ───────────────────────────────────────────────────────────────
# Production:            https://api.ideamart.io   (alias: https://api.dialog.lk)
# Local mock:            http://localhost:4010
IDEAMART_BASE_URL=https://api.ideamart.io

# LBS lives on a different host. Leave blank if you do not use LBS.
IDEAMART_LBS_URL=https://api.dialog.lk/lbs/locate

# API version sent with requests. Omit to let the platform use the latest.
IDEAMART_API_VERSION=1.0

# ── Behaviour ───────────────────────────────────────────────────────────────
# Timeout for a single outbound call, in milliseconds.
IDEAMART_TIMEOUT_MS=15000

# Retry attempts for transport errors and transient status codes (E16xx).
# Never applied to charging calls with a new externalTrxId.
IDEAMART_MAX_RETRIES=2

# Sender alias shown to users on MT SMS. Must be one of the aliases provisioned
# for your app, otherwise sends fail with E1331. Leave blank to use the default.
IDEAMART_SMS_SOURCE_ADDRESS=

# Request SMS delivery reports (0 = no, 1 = yes).
# Only enable if you actually consume the delivery-report callback.
IDEAMART_SMS_DELIVERY_REPORT=0

# Query Balance requires "Enable Query Balance Requests" in your app's CaaS
# provisioning. Set to false if it is not enabled, so the call is skipped
# rather than failing on every charge attempt.
IDEAMART_BALANCE_QUERY_ENABLED=true

# ── TLS ─────────────────────────────────────────────────────────────────────
# Some Ideamart hosts serve an incomplete certificate chain, which strict
# clients (Node.js) reject. The correct fix is to supply the missing
# intermediate CA here — NOT to disable verification.
# Path to a PEM bundle containing the intermediate (+ root) certificate.
IDEAMART_CA_BUNDLE_PATH=

# LAST RESORT, LOCAL DEVELOPMENT ONLY. Disables TLS certificate verification
# for Ideamart calls, exposing your credentials to interception. The config
# module refuses to start if this is set while NODE_ENV=production.
# To enable, set to exactly: yes-i-understand-the-risk
IDEAMART_INSECURE_TLS=

# ── Callback security ───────────────────────────────────────────────────────
# Comma-separated Ideamart egress IPs/CIDRs permitted to POST to your callback
# routes. Ask Ideamart support for the current list. Leave blank to disable the
# check (development only — an open callback endpoint is an abuse target).
IDEAMART_CALLBACK_ALLOWED_IPS=
